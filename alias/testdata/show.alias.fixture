[aliases]
  [aliases.example]
    name = "example"
    type = "local"
    verbose = false
    insecure = false
    detach = false
    source = [":8081"]
    destination = ["172.17.0.100:80"]
    server = "mole@127.0.0.1:22122"
    key = "test-env/ssh-server/keys/key"
    keep-alive-interval = "10s"
    connection-retries = 3
    wait-and-retry = "3s"
    ssh-agent = ""
    timeout = "3s"
    config = ""
    socks-auth = ""
    rpc = true
    rpc-address = "127.0.0.1:0"
  [aliases.multi]
    name = "multi"
    verbose = true
    insecure = false
    detach = false
    key = "path/to/key"
    keep-alive-interval = "10s"
    connection-retries = 3
    wait-and-retry = "3s"
    ssh-agent = ""
    timeout = "5s"
    config = "$HOME/.ssh/config"
    socks-auth = ""
    rpc = true
    rpc-address = "127.0.0.1:0"

    [[aliases.multi.tunnels]]
      server = "mole@bastion-a"

      [[aliases.multi.tunnels.forwards]]
        type = "local"
        source = [":8080"]
        destination = ["db:5432"]

      [[aliases.multi.tunnels.forwards]]
        type = "dynamic"
        source = [":1080"]

    [[aliases.multi.tunnels]]
      server = "mole@bastion-b:2222"
      key = "path/to/other/key"
      connection-retries = 0
      insecure = true

      [[aliases.multi.tunnels.forwards]]
        type = "remote"
        source = ["0.0.0.0:9000"]
        destination = ["127.0.0.1:3000"]
  [aliases.test-env]
    name = "test-env"
    type = "local"
    verbose = true
    insecure = true
    detach = false
    source = [":21112", ":21113"]
    destination = ["192.168.33.11:80", "192.168.33.11:8080"]
    server = "mole@127.0.0.1:22122"
    key = "test-env/ssh-server/keys/key"
    keep-alive-interval = "2s"
    connection-retries = 3
    wait-and-retry = "3s"
    ssh-agent = ""
    timeout = "3s"
    config = ""
    socks-auth = ""
    rpc = true
    rpc-address = "127.0.0.1:0"
