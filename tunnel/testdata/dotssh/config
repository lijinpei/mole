Host test
    Hostname 127.0.0.1
    Port 2222
    User mole_test
    IdentityFile ~/.ssh/id_rsa

Host test*
    Hostname 172.17.0.1
    Port 2223
    User mole_test2
    IdentityFile ~/.ssh/other_key

Host hostWithLocalForward
    Hostname 127.0.0.1
    Port 2222
    LocalForward 8080 172.17.0.1:8080
    User mole_test
    IdentityFile ~/.ssh/id_rsa

Host hostWithTwoLocalForwards
    Hostname 127.0.0.1
    Port 2222
    LocalForward 8080 172.17.0.1:8080
    LocalForward 9090 172.17.0.1:9090
    User mole_test
    IdentityFile ~/.ssh/id_rsa

Host hostWithDynamicForward
    Hostname 127.0.0.1
    Port 2222
    DynamicForward 1080
    User mole_test
    IdentityFile ~/.ssh/id_rsa

Host hostWithTwoDynamicForwards
    Hostname 127.0.0.1
    Port 2222
    DynamicForward 1080
    DynamicForward 192.168.1.1:1081
    User mole_test
    IdentityFile ~/.ssh/id_rsa

Host hostWithRemoteForward
    Hostname 127.0.0.1
    Port 2222
    RemoteForward 8080 172.17.0.1:8080
    User mole_test
    IdentityFile ~/.ssh/id_rsa

Host hostWithReverseDynamicForward
    Hostname 127.0.0.1
    Port 2222
    RemoteForward 1080
    User mole_test
    IdentityFile ~/.ssh/id_rsa

Host hostWithReverseDynamicAndRemoteForwards
    Hostname 127.0.0.1
    Port 2222
    RemoteForward 1080
    RemoteForward 8080 172.17.0.1:8080
    RemoteForward 192.168.1.1:1081
    User mole_test
    IdentityFile ~/.ssh/id_rsa
